# ចម្លង file នេះ ហើយប្តូរឈ្មោះទៅ .env
# ដាក់ API key របស់អ្នកនៅត្រង់នេះ (មិត្តអ្នកឲ្យ)

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# សម្រាប់ Sign In — ដាក់ជា text ចៃដន្យវែងណាមួយ (សម្រាប់ security នៃ login token)
JWT_SECRET=change-this-to-any-long-random-text-12345

# Port សម្រាប់ run server local (មិនចាំបាច់ប្តូរ)
PORT=3000
